POSTGRES_USER=revenda
POSTGRES_PASSWORD=revenda

# Endereco onde este servico busca o JWKS do servico de identidade, que roda fora
# desta stack. Precisa bater com o JWT_ISSUER configurado la, senao o emissor do token
# nao confere com o esperado aqui.
JWT_AUTHORITY=http://host.docker.internal:8081
JWT_ISSUER=http://host.docker.internal:8081
JWT_AUDIENCE=revenda-vehicles
JWT_REQUIRE_HTTPS=false

# Segredo combinado com o gateway, enviado no header X-Webhook-Secret.
PAYMENT_WEBHOOK_SECRET=troque-este-segredo
